NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Required for the server-side Supabase client. Never expose the service role key to a browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-side-service-role-key

# Request limits are configurable for the deployment environment.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=120

# Integration credentials are intentionally not required until their implementation phases.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# PAYSTACK_SECRET_KEY=
# PAYSTACK_WEBHOOK_SECRET=
# RESEND_API_KEY=
